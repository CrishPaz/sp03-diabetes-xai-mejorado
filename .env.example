# Configuración del Backend FastAPI (SP-03 Diabetes XAI)
API_HOST=0.0.0.0
API_PORT=8000
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:4173

# Rutas de artefactos y datos
MODEL_ARTIFACTS_DIR=models
DATA_DIR=data
DEFAULT_DATASET=nhanes_2017_2018
RANDOM_SEED=42

# Configuración del Frontend (Vite)
VITE_API_BASE_URL=http://localhost:8000

# Proveedor LLM (Fase 0) — API compatible con OpenAI
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-chat
LLM_TEMPERATURE=0.1
LLM_TIMEOUT_S=30
LLM_MAX_RETRIES=2
