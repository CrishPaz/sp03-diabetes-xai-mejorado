{
  "name": "WF-04: Generación y Distribución de Alertas de Riesgo Cardiometabólico",
  "nodes": [
    {
      "parameters": {
        "httpMethod": "POST",
        "path": "wf04-risk-alert",
        "options": {}
      },
      "id": "node-webhook-risk",
      "name": "Webhook: Predicción Recibida",
      "type": "n8n-nodes-base.webhook",
      "typeVersion": 2,
      "position": [180, 240]
    },
    {
      "parameters": {
        "conditions": {
          "number": [
            {
              "value1": "={{ $json.probability }}",
              "operation": "largerEqual",
              "value2": 0.75
            }
          ]
        }
      },
      "id": "node-filter-high-risk",
      "name": "¿Riesgo Alto o Muy Alto (≥ 75%)?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2,
      "position": [420, 240]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "http://backend:8000/api/v1/n8n/webhook/alert",
        "jsonParameters": true,
        "bodyParametersJson": "={\n  \"workflow_id\": \"WF-04\",\n  \"event\": \"alerta_riesgo_critico\",\n  \"patient_probability\": $json.probability,\n  \"risk_stratum\": $json.risk_stratum,\n  \"top_factors\": $json.top_risk_factor || 'HbA1c / Glucosa',\n  \"level\": \"CRITICAL\",\n  \"timestamp\": new Date().toISOString()\n}"
      },
      "id": "node-dispatch-alert",
      "name": "Emitir Alerta Clínica a Dashboard",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [680, 180]
    }
  ],
  "connections": {
    "Webhook: Predicción Recibida": {
      "main": [
        [
          {
            "node": "¿Riesgo Alto o Muy Alto (≥ 75%)?",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "¿Riesgo Alto o Muy Alto (≥ 75%)?": {
      "main": [
        [
          {
            "node": "Emitir Alerta Clínica a Dashboard",
            "type": "main",
            "index": 0
          }
        ]
      ]
    }
  },
  "active": true
}
